{
    "name": "josephobaje/paystack-payment-integration-php",
    "description": "Paystack payment integration in plain PHP 8: initialize, verify, webhook signature validation and a demo checkout.",
    "type": "project",
    "license": "MIT",
    "authors": [{ "name": "Joseph Obaje", "email": "josephobaje264@gmail.com" }],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "App\\": "src/" } },
    "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "serve": "php -S localhost:8000 -t public"
    }
}
