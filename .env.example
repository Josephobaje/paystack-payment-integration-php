# Paystack keys: https://dashboard.paystack.com/#/settings/developers
# Use test keys (sk_test_ / pk_test_) while developing. Never commit your real .env.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_URL=http://localhost:8000
# Optional: reject webhooks that don't come from Paystack's IPs (enable in production)
PAYSTACK_ENFORCE_IP=false
